#!/usr/bin/env zsh
set -euo pipefail

readonly REPO_ROOT="$(cd "$(dirname "$(realpath "$0")")/../.." && pwd)"

cmd="${1:-}"

case "$cmd" in
    build)
        exec "$REPO_ROOT/.script/docker-build-laser" "${@:2}"
        ;;
    push)
        docker push ghcr.io/yukikaze2233/laser-guidance:latest
        ;;
    pull)
        docker pull ghcr.io/yukikaze2233/laser-guidance:latest
        ;;
    foxglove)
        exec "$REPO_ROOT/.script/foxglove-laser" "${@:2}"
        ;;
    shell)
        cd "$REPO_ROOT"
        docker compose --profile dev up -d dev 2>/dev/null || true
        exec docker compose --profile dev exec -u 1000:1000 dev zsh
        ;;
    *)
        cd "$REPO_ROOT"
        exec zsh
        ;;
esac

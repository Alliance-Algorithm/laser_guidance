#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STORE="$SCRIPT_DIR/.config-path"
source "$SCRIPT_DIR/host-runtime-env.sh"
laser_prepare_host_runtime_env

CONFIG="${1:-}"
if [ -z "$CONFIG" ]; then
    if [ -f "$STORE" ]; then
        CONFIG="$(cat "$STORE")"
    else
        CONFIG="$REPO_ROOT/config/default.yaml"
    fi
fi
if [[ "$CONFIG" != /* ]]; then
    CONFIG="$REPO_ROOT/$CONFIG"
fi
CONFIG="$(realpath "$CONFIG")"

CAPTURE_BACKEND="$(
    python3 - "$CONFIG" <<'PYEOF'
import sys, yaml
cfg = yaml.safe_load(open(sys.argv[1]))
print(cfg.get('capture_backend', 'v4l2'))
PYEOF
)"

if [ "$CAPTURE_BACKEND" = "hikcamera" ]; then
    source "$SCRIPT_DIR/hik-mvs-env.sh"
    laser_configure_hik_mvs_env
fi

OUTPUT="${2:-$REPO_ROOT/videos}"
DURATION="${3:-120}"

echo "=== 视频会话录制 ==="
echo "配置: $CONFIG"
echo "输出: $OUTPUT"
echo "时长: ${DURATION}s"
echo ""

cd "$REPO_ROOT"
./build/tool_record "$CONFIG" "$OUTPUT" "$DURATION"

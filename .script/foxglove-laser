#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

PORT="${1:-8765}"

launch_in_container() {
    cd "$REPO_ROOT"
    docker compose --profile dev up -d dev 2>/dev/null || true
    docker compose --profile dev exec -T dev \
        bash -c "source /opt/ros/jazzy/setup.bash && ros2 launch foxglove_bridge foxglove_bridge_launch.xml port:=${PORT}"
}

if command -v ros2 &>/dev/null; then
    echo "=== Launching Foxglove bridge on ws://0.0.0.0:${PORT} ==="
    ros2 launch foxglove_bridge foxglove_bridge_launch.xml port:="${PORT}"
else
    echo "=== ros2 not found on host — launching in container ==="
    launch_in_container
fi

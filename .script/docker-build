#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

IMAGE="yukikaze2233/laser-guidance:latest"
PUSH=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --push) PUSH=true; shift ;;
        --tag)  IMAGE="$2"; shift 2 ;;
        *)      echo "Usage: $0 [--push] [--tag IMAGE]"; exit 1 ;;
    esac
done

echo "=== Building ${IMAGE} ==="
docker build -t "${IMAGE}" .

if $PUSH; then
    echo "=== Pushing ${IMAGE} ==="
    docker push "${IMAGE}"
fi
echo "=== Done ==="

#!/usr/bin/env bash
set -euo pipefail
FIFO="/tmp/laser_cmd"
SDP="/tmp/laser_guidance.sdp"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STORE="$SCRIPT_DIR/.config-path"
source "$SCRIPT_DIR/rtp-common.sh"
source "$SCRIPT_DIR/host-runtime-env.sh"
laser_prepare_host_runtime_env
CONFIG="${1:-}"
[ -z "$CONFIG" ] && CONFIG="$(cat "$STORE" 2>/dev/null || echo "$REPO_ROOT/config/direct_voltage_run.yaml")"
if [[ -n "$CONFIG" && "$CONFIG" != /* ]]; then
    CONFIG="$REPO_ROOT/$CONFIG"
fi
CONFIG="$(realpath "$CONFIG")"
HEADLESS="${LASER_HEADLESS:-0}"

TMP_CONFIG=""
LOG_DIR="$REPO_ROOT/logs/$(date +%Y-%m-%d_%H-%M-%S)"
LOG_FILE="$LOG_DIR/laser_competition.log"
cleanup() { rm -f "$TMP_CONFIG"; }
trap cleanup EXIT
mkdir -p "$LOG_DIR"

{
    IFS=$'\n' read -r CAPTURE_BACKEND
    IFS=$'\n' read -r RTP_HOST
    IFS=$'\n' read -r RTP_PORT
    IFS=$'\n' read -r STREAMING_ENABLED
} < <(python3 - "$CONFIG" << 'PYEOF'
import sys, yaml
path = sys.argv[1]
cfg = yaml.safe_load(open(path))
print(cfg.get('capture_backend', 'v4l2'))
print(cfg.get('streaming', {}).get('host', '127.0.0.1'))
print(cfg.get('streaming', {}).get('port', 5004))
print(cfg.get('streaming', {}).get('enabled', False))
PYEOF
)
if [ "$CAPTURE_BACKEND" = "hikcamera" ]; then
    source "$SCRIPT_DIR/hik-mvs-env.sh"
    laser_configure_hik_mvs_env
fi
if [[ "$HEADLESS" == "1" || "$HEADLESS" == "true" || "$HEADLESS" == "TRUE" ]]; then
    STREAMING_ENABLED=False
fi

launch_ffplay() {
    if ! command -v ffplay >/dev/null 2>&1; then
        echo "warning: ffplay not found; daemon keeps running, but local playback is skipped"
        return 0
    fi
    ffplay -hide_banner -loglevel warning -nostats -protocol_whitelist file,rtp,udp -fflags nobuffer -flags low_delay -probesize 32 -analyzeduration 0 -sync ext "$SDP"
}

if [ -p "$FIFO" ] && timeout 1 bash -c "echo 'stream on' > '$FIFO'" 2>/dev/null; then
    echo "competition daemon already running"
    if [ "$STREAMING_ENABLED" = "True" ]; then
        laser_wait_for_sdp "$SDP" "" "running competition daemon" "$LOG_FILE" || exit 1
        launch_ffplay
    else
        echo "streaming disabled; FIFO: echo '<cmd>' > $FIFO"
        echo "  stream on/off | record on/off | enemy red/blue/auto | backend tensorrt/onnx | quit"
        while true; do sleep 1; done
    fi
    exit 0
fi

pkill -9 -f "tool_competition" 2>/dev/null || true
pkill -9 -f "tool_preview" 2>/dev/null || true
TMP_CONFIG="$(mktemp /tmp/laser_guidance_competition_XXXX.yaml)"

python3 - "$CONFIG" "$TMP_CONFIG" << 'PYEOF'
import os, sys, yaml
cfg = yaml.safe_load(open(sys.argv[1]))
cfg.setdefault('debug', {})['show_window'] = False
camera_device = os.environ.get('LASER_CAMERA_DEVICE', '').strip()
if camera_device:
    cfg.setdefault('v4l2', {})['device_path'] = camera_device
headless = os.environ.get('LASER_HEADLESS', '').lower() in ('1', 'true', 'yes', 'on')
if headless:
    cfg.setdefault('streaming', {})['enabled'] = False
yaml.dump(cfg, open(sys.argv[2], 'w'), default_flow_style=False, allow_unicode=True)
PYEOF

cd "$REPO_ROOT"
rm -f "$SDP"
echo "=== 比赛模式 (守护进程) ==="
echo "配置: $CONFIG"
echo "日志: $LOG_FILE"
./build/tool_competition "$TMP_CONFIG" >/dev/null 2>"$LOG_FILE" &
COMPETITION_PID=$!
echo "PID: $COMPETITION_PID"
echo ""
echo "FIFO 控制命令:"
echo "  stream on/off           推流开关"
echo "  record on/off           录制开关"
echo "  enemy red/blue/auto     敌方颜色"
echo "  backend tensorrt/onnx   推理后端"
echo "  quit                    退出"

if [ "$STREAMING_ENABLED" = "True" ]; then
    disown "$COMPETITION_PID"
    if ! laser_wait_for_sdp "$SDP" "$COMPETITION_PID" "tool_competition" "$LOG_FILE"; then
        if kill -0 "$COMPETITION_PID" 2>/dev/null; then
            echo "tool_competition is still running; waiting for camera/frames, daemon left running"
            exit 0
        fi
        exit 1
    fi
    launch_ffplay
    echo "ffplay exited (likely RTP not ready at startup); daemon keeps running, use FIFO 'quit' to stop"
    if kill -0 "$COMPETITION_PID" 2>/dev/null; then
        exit 0
    fi
    exit 1
else
    wait "$COMPETITION_PID"
fi

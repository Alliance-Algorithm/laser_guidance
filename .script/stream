#!/usr/bin/env bash
set -euo pipefail
FIFO="/tmp/laser_cmd"
SDP="/tmp/laser_guidance.sdp"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STORE="$SCRIPT_DIR/.config-path"
source "$SCRIPT_DIR/rtp-common.sh"
source "$SCRIPT_DIR/host-runtime-env.sh"
laser_prepare_host_runtime_env
CONFIG="${1:-}"
[ -z "$CONFIG" ] && CONFIG="$(cat "$STORE" 2>/dev/null || echo "$REPO_ROOT/config/hik_competition.yaml")"
if [[ "$CONFIG" != /* ]]; then
    CONFIG="$REPO_ROOT/$CONFIG"
fi
CONFIG="$(realpath "$CONFIG")"

TMP_CONFIG=""
LOG_DIR="$REPO_ROOT/logs/$(date +%Y-%m-%d_%H-%M-%S)"
LOG_FILE="$LOG_DIR/laser_daemon.log"
PREVIEW_PID=""
KEEP_PREVIEW_RUNNING=0

cleanup() {
    if [ "${KEEP_PREVIEW_RUNNING:-0}" != "1" ] \
        && [ -n "$PREVIEW_PID" ] \
        && kill -0 "$PREVIEW_PID" 2>/dev/null; then
        kill "$PREVIEW_PID" 2>/dev/null || true
        wait "$PREVIEW_PID" 2>/dev/null || true
    fi
    rm -f "$TMP_CONFIG" "$SDP"
}
trap cleanup EXIT

mkdir -p "$LOG_DIR"

{
    IFS=$'\n' read -r CAPTURE_BACKEND
    IFS=$'\n' read -r RTP_HOST
    IFS=$'\n' read -r RTP_PORT
    IFS=$'\n' read -r STREAMING_ENABLED
} < <(python3 - "$CONFIG" <<'PYEOF'
import sys, yaml

cfg = yaml.safe_load(open(sys.argv[1]))
streaming = cfg.get('streaming', {})

print(cfg.get('capture_backend', 'v4l2'))
print(streaming.get('host', '127.0.0.1'))
print(streaming.get('port', 5004))
print(streaming.get('enabled', False))
PYEOF
)

if [ "$CAPTURE_BACKEND" = "hikcamera" ]; then
    source "$SCRIPT_DIR/hik-mvs-env.sh"
    laser_configure_hik_mvs_env
fi

launch_ffplay() {
    if ! command -v ffplay >/dev/null 2>&1; then
        echo "warning: ffplay not found; daemon keeps running, but local playback is skipped"
        return 0
    fi
    # Prefer CUDA decode when available (full-res UI stays smooth on GPU).
    local dec_args=()
    if ffmpeg -hide_banner -decoders 2>/dev/null | grep -q h264_cuvid; then
        dec_args=(-hwaccel cuda -c:v h264_cuvid)
    fi
    ffplay -hide_banner -loglevel warning -nostats \
        -protocol_whitelist file,rtp,udp \
        -fflags nobuffer+discardcorrupt \
        -flags low_delay \
        -framedrop \
        -infbuf \
        -probesize 32 \
        -analyzeduration 0 \
        -sync ext \
        "${dec_args[@]}" \
        "$SDP"
}

# Daemon already running: just launch ffplay if streaming enabled
if [ -p "$FIFO" ] && timeout 1 bash -c "echo 'stream on' > '$FIFO'" 2>/dev/null; then
    if [ "$STREAMING_ENABLED" = "True" ]; then
        laser_wait_for_sdp "$SDP" "" "running daemon" "$LOG_FILE" || exit 1
        launch_ffplay
    else
        echo "daemon running, video at /laser_frame (Ctrl+C to stop)"
        while true; do sleep 1; done
    fi
    exit 0
fi

# Cold start: respect config value, don't force-enable streaming
pkill -9 -f "tool_preview" 2>/dev/null || true
TMP_CONFIG="$(mktemp /tmp/laser_guidance_stream_XXXX.yaml)"

python3 - "$CONFIG" "$TMP_CONFIG" <<'PYEOF'
import sys, yaml

cfg = yaml.safe_load(open(sys.argv[1]))
cfg.setdefault('debug', {})['show_window'] = False

with open(sys.argv[2], 'w') as f:
    yaml.dump(cfg, f, default_flow_style=False, allow_unicode=True)
PYEOF

cd "$REPO_ROOT"
rm -f "$SDP" "$LOG_FILE"

./build/tool_preview "$TMP_CONFIG" >"$LOG_FILE" 2>&1 &
PREVIEW_PID=$!

if [ "$STREAMING_ENABLED" = "True" ]; then
    if ! laser_wait_for_sdp "$SDP" "$PREVIEW_PID" "tool_preview" "$LOG_FILE"; then
        if [ -n "$PREVIEW_PID" ] && kill -0 "$PREVIEW_PID" 2>/dev/null; then
            echo "tool_preview is still running; waiting for camera/frames, daemon left running"
            KEEP_PREVIEW_RUNNING=1
            exit 0
        fi
        exit 1
    fi
    launch_ffplay
else
    wait "$PREVIEW_PID"
fi

#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STORE="$SCRIPT_DIR/.config-path"

list_configs() {
    echo "可用的配置文件:"
    i=1
    for f in "$REPO_ROOT"/config/*.yaml; do
        local name="$(basename "$f")"
        local rel="$(realpath --relative-to="$REPO_ROOT" "$f")"
        local mark=" "
        if [ -f "$STORE" ] && [ "$(cat "$STORE")" = "$rel" ]; then
            mark="*"
        fi
        printf "  %s %d) %s\n" "$mark" "$i" "$name"
        eval "cfg_$i=\"$rel\""
        ((i++))
    done
}

if [ $# -gt 0 ]; then
    rel="$(realpath --relative-to="$REPO_ROOT" "$(realpath "$1")")"
    echo "$rel" > "$STORE"
    echo "已选择: $rel"
    exit 0
fi

list_configs
echo ""
read -rp "选择配置 [1-$((i-1))]: " choice
cfg_var="cfg_$choice"
if [ -z "${!cfg_var:-}" ]; then
    echo "无效选择"
    exit 1
fi
echo "${!cfg_var}" > "$STORE"
echo "已选择: ${!cfg_var}"
